// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  service     String
  date        String
  time        String
  address     String
  notes       String?
  status      String   @default("pending") // pending, confirmed, completed, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Int      // 1-5
  comment   String
  service   String?
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    String   // "user", "bot", or "support"
  message   String
  createdAt DateTime @default(now())
}

model ChatSession {
  id              String   @id @default(cuid())
  customerName    String?
  handoffRequested Boolean @default(false)  // AI requested handoff, waiting for admin approval
  needsHuman      Boolean  @default(false)  // Admin approved, human should respond
  takenOver       Boolean  @default(false)  // Human has responded
  finished        Boolean  @default(false)  // Conversation finished by admin
  messages        ChatMessage[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("new") // new, read, responded
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  image       String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id            String   @id @default(cuid())
  businessName  String   @default("Climate Tech Plumbing & Renovators")
  phone         String   @default("0720 219802")
  phone2        String?  // Secondary phone
  email         String   @default("info@climatetechplumbing.co.ke")
  address       String   @default("Thika Rd, Nairobi, Kenya")
  businessHours String   @default("24/7 Emergency Services Available")
  heroTitle     String   @default("Professional Plumbing & Borehole Services")
  heroSubtitle  String   @default("Expert solutions for all your plumbing, borehole drilling, and water system needs in Nairobi & Kenya")
  heroImage     String?  // URL to hero background image
  aboutTitle    String   @default("About Climate Tech Plumbing")
  aboutContent  String   @default("We are a professional plumbing company dedicated to providing high-quality services.")
  aboutImage    String?  // URL to about section image
  logoUrl       String?  // URL to logo image
  facebook      String?  // Facebook URL
  twitter       String?  // Twitter/X URL
  instagram     String?  // Instagram URL
  whatsapp      String?  // WhatsApp number
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
